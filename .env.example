# Copy to .env and fill in. .env is git-ignored; never commit it.
#   cp .env.example .env && chmod 600 .env
#
# Server-wide Claude API key. Optional: users can instead paste their own key in Settings
# (it stays in their browser). Create one at https://console.anthropic.com/settings/keys
ANTHROPIC_API_KEY=

# PITCHCRAFT_DATA=data
# PITCHCRAFT_AUTH=on
# PITCHCRAFT_SECURE_COOKIE=1
